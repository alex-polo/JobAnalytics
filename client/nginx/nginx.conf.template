server {
  listen 80;

  client_max_body_size 100M;
  
  absolute_redirect off; 

  location / {
    root /usr/share/nginx/html;
    index index.html index.htm;
    try_files $uri /index.html = 404;
  }

  location ${BACKEND_API_PREFIX} {
    proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
    
    # Pass original Host from browser
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_connect_timeout 60s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
  }

location ${FLOWER_API_PREFIX}/ {
    proxy_pass http://${FLOWER_HOST}:${FLOWER_PORT};
    
    proxy_set_header Host $http_host;
    
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    proxy_read_timeout 86400;
}

location ${PGADMIN_API_PREFIX}/ {
    proxy_pass http://${PGADMIN_HOST}:${PGADMIN_PORT}/;
    
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_set_header X-Script-Name ${PGADMIN_API_PREFIX};
    proxy_redirect off;
}

  include /etc/nginx/extra-conf.d/*.conf;
}
